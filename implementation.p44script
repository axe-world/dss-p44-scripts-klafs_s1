// Klafs Sauna S1 - plan44 Scripted Device
// Version 4: beschleunigte Sauna-ID-Suche (kurzer HTML-Ausschnitt).
// Achtung: Remote-Start nur bei bestandener Klafs-Sicherheitskontrolle!
// Zugangsdaten und PIN konfigurieren; Sauna-ID wird automatisch erkannt.
// Bei mehreren registrierten Saunen wird aus Sicherheitsgruenden keine gewaehlt.
var base = 'https://sauna-app-19.klafs.com';
var klafsUserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/59.0.3071.71 Safari/537.36';
var saunaId = ''; // Wird nach dem Login aus der Klafs-Antwort ermittelt
var username = 'HIER_USERNAME_EINTRAGEN';
var password = 'HIER_PASSWORT_EINTRAGEN';
var pin = 'HIER_PIN_EINTRAGEN';

var sessionCookie = '';
var busy = false;
// Letzte bestaetigte API-Zustaende; bei erstem Poll kein Event senden.
var lastPoweredOn = null;
var lastHeatedUp = null;

// Sauna-ID nur in einem kurzen Ausschnitt um das Feld suchen.
// Die HTML-Antwort von ChangeSettings kann sehr gross sein. Daher kein
// wiederholtes GUID-Scanning ueber den gesamten HTTP-Response-String.
function isSaunaGuid(id) {
  if (strlen(id)!=36) return false;
  if (substr(id,8,1)!='-' || substr(id,13,1)!='-' || substr(id,18,1)!='-' || substr(id,23,1)!='-') return false;
  var alphabet = '0123456789abcdef';
  var lower = lowercase(id);
  for (var i=0; i<36; i++) {
    if (i!=8 && i!=13 && i!=18 && i!=23) {
      if (!isvalid(find(alphabet,substr(lower,i,1)))) return false;
    }
  }
  return true;
}

function findGuidAtMarker(text, marker) {
  var pos = find(text,marker);
  if (!isvalid(pos)) return '';

  // Aus dem grossen HTML nur maximal 240 Zeichen ausschneiden.
  // Die erste Trennstelle einer GUID liegt bei Zeichen 9.
  var snippet = substr(text,pos+strlen(marker),240);
  var found = '';
  var remaining = snippet;
  var offset = 0;
  var attempts = 0;
  while (strlen(remaining)>0 && attempts<32) {
    var dash = find(remaining,'-');
    if (!isvalid(dash)) break;
    var start = offset+dash-8;
    if (start>=0 && start+36<=strlen(snippet)) {
      var candidate = substr(snippet,start,36);
      if (isSaunaGuid(candidate)) {
        if (found!='' && lowercase(found)!=lowercase(candidate)) throw 'Klafs: mehrere Sauna-IDs gefunden';
        found = candidate;
      }
    }
    offset=offset+dash+1;
    remaining=substr(snippet,offset);
    attempts=attempts+1;
  }
  return found;
}

function findSaunaId(text) {
  if (!isvalid(text)) return '';
  var html = string(text);
  // Der regulaere Fall: SelectedCabin ist in ChangeSettings enthalten.
  // Alternative Feldnamen nur pruefen, wenn SelectedCabin nicht vorkommt.
  var found = findGuidAtMarker(html,'SelectedCabin');
  // Bei mehreren ausgewaehlten Kabinen keine fremde ID uebernehmen.
  // Nur eine zusaetzliche Suche, nicht jede GUID im kompletten HTML pruefen.
  if (found!='') {
    var firstMarker = find(html,'SelectedCabin');
    var rest = substr(html,firstMarker+strlen('SelectedCabin'));
    var another = findGuidAtMarker(rest,'SelectedCabin');
    if (another!='' && lowercase(another)!=lowercase(found)) throw 'Klafs: mehrere Sauna-IDs gefunden';
  }
  if (found=='') found = findGuidAtMarker(html,'selectedCabin');
  if (found=='') found = findGuidAtMarker(html,'SaunaId');
  if (found=='') found = findGuidAtMarker(html,'saunaId');
  if (found=='') found = findGuidAtMarker(html,'?s=');
  return found;
}

function discoverSaunaId() {
  if (saunaId!='') return;
  if (sessionCookie=='') throw 'Klafs: keine Sitzung zur ID-Ermittlung';
  // Die Sauna-ID wird direkt aus ChangeSettings gelesen.
  // Der zuvor ausgefuehrte GET / ist nicht erforderlich.
  log(5,'Klafs ID-Suche: ChangeSettings wird angefordert');
  var settings = request('/SaunaApp/ChangeSettings','GET',null,true);
  log(5,'Klafs ID-Suche: ChangeSettings empfangen');
  saunaId = findSaunaId(settings.data);
  if (saunaId=='') throw 'Klafs: SelectedCabin/Sauna-ID in ChangeSettings nicht gefunden';
  log(5,'Klafs: Sauna-ID automatisch erkannt');
}

function ensureSaunaId() {
  if (sessionCookie=='') login();
  if (saunaId=='') discoverSaunaId();
}

function extractCookie(headers) {
  // httprequest(withmeta) liefert response headers, die genaue Darstellung
  // mehrerer Set-Cookie Header kann firmwareabhängig sein.
  var header = ifok(headers['set-cookie'], null);
  if (!isvalid(header)) header = ifok(headers['Set-Cookie'], null);
  if (!isvalid(header)) return false;
  var s = string(header);
  var p = find(s, '.ASPXAUTH=');
  if (!isvalid(p)) return false;
  var token = substr(s,p);
  var end = find(token,';');
  if (isvalid(end)) token = substr(token,0,end+1);
  sessionCookie = token;
  return true;
}

function request(path, method, data, authenticated) {
  var h = {'User-Agent':klafsUserAgent};
  if (authenticated && sessionCookie!='') h['Cookie'] = sessionCookie;
  var req = {url:base+path, method:method, headers:h, timeout:15, withmeta:true};
  if (isvalid(data)) req.data = data;
  var r = httprequest(req);
  if (!isvalid(r) || !isvalid(r.status)) throw 'Klafs HTTP ohne Antwort';
  if (r.status<200 || r.status>=300) throw format('Klafs HTTP %d (%s)',r.status,path);
  if (isvalid(r.data)) {
    var s = string(r.data);
    if (isvalid(find(s,'"LoginRequired":true'))) throw 'Klafs LoginRequired';
    if (isvalid(find(s,'security check')) || isvalid(find(s,'Sicherheitskontrolle'))) throw 'Klafs Sicherheitskontrolle nicht bestätigt';
  }
  return r;
}

function login() {
  if (username=='' || username=='HIER_USERNAME_EINTRAGEN' || password=='' || password=='HIER_PASSWORT_EINTRAGEN') throw 'Klafs Credentials fehlen';

  var r = httprequest({url:base+'/Account/Login', method:'POST',
    headers:{'User-Agent':klafsUserAgent},
    data:{UserName:username, Password:password}, formdata:true,
    timeout:20, withmeta:true});
  if (!isvalid(r) || !isvalid(r.status) || r.status<200 || r.status>=300) throw 'Klafs Login HTTP Fehler';
  if (!extractCookie(r.headers)) throw 'Klafs Login: .ASPXAUTH Cookie nicht in Antwortheadern gefunden';

  // Wenn die Login-Antwort bereits eine Sauna-ID enthaelt, wird sie verwendet.
  // Ansonsten wird direkt ChangeSettings abgefragt.
  saunaId = findSaunaId(r.data);
  if (saunaId=='') {
    var location = ifok(r.headers['location'], null);
    if (!isvalid(location)) location = ifok(r.headers['Location'], null);
    saunaId = findSaunaId(location);
  }
  log(5,'Klafs Login: Sitzungscookie erhalten');
  if (saunaId!='') log(5,'Klafs: Sauna-ID aus Login-Antwort erkannt');
}

function authed(path,method,data) {
  ensureSaunaId();
  var r = request(path,method,data,true);
  return r;
}

function refresh() {
  log(5,'Klafs: Polling gestartet');
  ensureSaunaId();
  log(5,'Klafs: Sauna-ID vorhanden, rufe GetData ab');
  var r = authed('/SaunaApp/GetData?id='+saunaId,'GET',null);
  log(5,'Klafs: GetData empfangen');
  var d = json(r.data);
  if (!isvalid(d) || !isvalid(d.isPoweredOn) || !isvalid(d.isReadyForUse)) throw 'Klafs Statusfelder fehlen';
  // Die Werte werden ohne Umrechnung übernommen. "currentHumidity"
  if (isvalid(d.currentTemperature)) message({message:'sensor',index:0,value:d.currentTemperature});
  else message({message:'sensor',index:0,value:null});
  if (isvalid(d.currentHumidity)) message({message:'sensor',index:1,value:d.currentHumidity});
  else message({message:'sensor',index:1,value:null});
  if (isvalid(d.selectedSaunaTemperature)) message({message:'sensor',index:2,value:d.selectedSaunaTemperature});
  else message({message:'sensor',index:2,value:null});
  if (isvalid(d.selectedSanariumTemperature)) message({message:'sensor',index:3,value:d.selectedSanariumTemperature});
  else message({message:'sensor',index:3,value:null});
  // Klafs-API Booleanwerte in definierte Enumeration-States umwandeln.
  // Der Ofenstatus richtet sich zuerst nach der Einschaltung.
  // Ein + nicht bereit = Heizt auf; Ein + bereit = Fertig aufgeheizt;
  // Aus = Kühlt ab / kalt, unabhängig von isReadyForUse.
  var poweredOn = 'Aus';
  var ovenStatus = 'Kühlt ab / kalt';
  if (d.isPoweredOn) {
    poweredOn = 'Ein';
    ovenStatus = 'Heizt auf';
    if (d.isReadyForUse) ovenStatus = 'Fertig aufgeheizt';
  }
  log(3, 'Klafs API: isPoweredOn=%s, isReadyForUse=%s', d.isPoweredOn, d.isReadyForUse);
  log(3, 'Klafs States: Eingeschaltet=%s, Saunaofen=%s', poweredOn, ovenStatus);
  message({message:'pushNotification',statechange:{Eingeschaltet:poweredOn}});
  message({message:'pushNotification',statechange:{Saunaofen:ovenStatus}});

  // Events nur bei echten Zustandswechseln; keinen Event beim ersten Abruf.
  var nowPoweredOn = poweredOn == 'Ein';
  var nowHeatedUp = ovenStatus == 'Fertig aufgeheizt';
  if (lastPoweredOn != null) {
    if (lastPoweredOn == false && nowPoweredOn == true) {
      log(3, 'Klafs EVENT: Sauna eingeschaltet');
      message({message:'pushNotification',events:['Sauna eingeschaltet']});
    } else if (lastPoweredOn == true && nowPoweredOn == false) {
      log(3, 'Klafs EVENT: Sauna ausgeschaltet');
      message({message:'pushNotification',events:['Sauna ausgeschaltet']});
    }
  }
  if (lastHeatedUp != null) {
    if (lastHeatedUp == false && nowHeatedUp == true) {
      log(3, 'Klafs EVENT: Sauna aufgeheizt');
      message({message:'pushNotification',events:['Sauna aufgeheizt']});
    } else if (lastHeatedUp == true && nowHeatedUp == false) {
      log(3, 'Klafs EVENT: Sauna nicht aufgeheizt');
      message({message:'pushNotification',events:['Sauna nicht aufgeheizt']});
    }
  }
  lastPoweredOn = nowPoweredOn;
  lastHeatedUp = nowHeatedUp;
  message({message:'opstate',level:100,text:'Klafs API OK'});
  return d;
}

function changeMode(mode) {
  authed('/SaunaApp/SetMode','POST',{id:saunaId, selected_mode:mode});
}
function changeTemperature(temp) {
  authed('/SaunaApp/ChangeTemperature','POST',{id:saunaId,temperature:temp});
}
function changeHumidity(level) {
  authed('/SaunaApp/ChangeHumLevel','POST',{id:saunaId,level:level});
}
function powerOn() {
  if (pin=='HIER_PIN_EINTRAGEN') throw 'Klafs Einschalt-PIN fehlt';
  // Nur starten, wenn aktuell ausgeschaltet. Keine Umgehung von Freigaben!
  var d=refresh();
  if (!d.isPoweredOn) {
    authed('/SaunaApp/StartCabin','POST',
      {id:saunaId,pin:pin,time_selected:'false',sel_hour:0,sel_min:0});
  }
}
function powerOff() {
  authed('/SaunaApp/StopCabin','POST',{id:saunaId});
}

// Nur bekannte Aktionen zur asynchronen Ausfuehrung annehmen.
function knownAction(a) {
  return a=='ActTurnOn' || a=='ActTurnOff' ||
    a=='ActModeSauna' || a=='ActModeSanarium' || a=='ActModeIR' ||
    a=='ActSommerSaunaClassic' || a=='ActChilloutSauna' ||
    a=='ActAfterFitnessSauna' || a=='ActClassicSauna' ||
    a=='ActSoftSauna' || a=='ActSummerSaunaSoft' ||
    a=='ActRelaxSanarium' || a=='ActBeautySanarium' ||
    a=='ActFamilySanarium' || a=='ActImmunPowerSanarium' ||
    a=='ActVitalSanarium' || a=='ActTropenSanarium' ||
    a=='ActSubtropenSanarium' || a=='ActFitnessSanarium';
}

function executeAction(a) {
  if (a=='ActTurnOn') { powerOn(); return; }
  if (a=='ActTurnOff') { powerOff(); return; }
  if (a=='ActModeSauna') { changeMode(1); return; }
  if (a=='ActModeSanarium') { changeMode(2); return; }
  if (a=='ActModeIR') { changeMode(3); return; }
  var mode = 0;
  var temp = 0;
  var hum = -1;

  if (a=='ActSommerSaunaClassic') { mode=1; temp=75; } else if (a=='ActChilloutSauna') { mode=1; temp=80; } else if (a=='ActAfterFitnessSauna') { mode=1; temp=85; } else if (a=='ActClassicSauna') { mode=1; temp=90; } else if (a=='ActSoftSauna') { mode=1; temp=65; } else if (a=='ActSummerSaunaSoft') { mode=1; temp=70; } else if (a=='ActRelaxSanarium') { mode=2; temp=50; hum=4; } else if (a=='ActBeautySanarium') { mode=2; temp=55; hum=8; } else if (a=='ActFamilySanarium') { mode=2; temp=50; hum=8; } else if (a=='ActImmunPowerSanarium') { mode=2; temp=50; hum=6; } else if (a=='ActVitalSanarium') { mode=2; temp=45; hum=6; } else if (a=='ActTropenSanarium') { mode=2; temp=60; hum=10; } else if (a=='ActSubtropenSanarium') { mode=2; temp=60; hum=8; } else if (a=='ActFitnessSanarium') { mode=2; temp=55; hum=10; } else throw 'Unbekannte Klafs-Aktion';
  // Modus, Temperatur, ggf. Feuchte, einschalten.
  changeMode(mode);
  changeTemperature(temp);
  if (hum>=0) changeHumidity(hum);
  powerOn();
}

on (every(0:01)) {
  if (!busy) {
    busy=true;
    try { refresh(); } catch as e {
      log(3,'Klafs Polling fehlgeschlagen: %s',e);
      message({message:'opstate',level:0,text:'Klafs API Fehler'});
      // Keine veralteten Messungen als gültig stehen lassen.
      for (var i=0; i<4; i++) message({message:'sensor',index:i,value:null});
      // States nicht mit geratenen Werten ueberschreiben.
      // Bei API-Fehler bleibt der letzte bestaetigte Zustand bestehen.
    }
    busy=false;
  }
}

// Sofort quittieren, HTTPS-Sequenz im separaten Thread ausfuehren.
// confirmAction bedeutet hier: Auftrag angenommen, nicht physisch ausgefuehrt.
on (message()) as m {
  if (m.message=='invokeAction') {
    if (busy) {
      message({message:'confirmAction',action:m.action,errorcode:1,errortext:'Klafs beschaeftigt'});
    } else if (!knownAction(m.action)) {
      message({message:'confirmAction',action:m.action,errorcode:1,errortext:'Unbekannte Klafs-Aktion'});
    } else if (username=='' || username=='HIER_USERNAME_EINTRAGEN' ||
             password=='' || password=='HIER_PASSWORT_EINTRAGEN' ||
             ((m.action=='ActTurnOn' ||
               (m.action!='ActTurnOff' && m.action!='ActModeSauna' &&
                m.action!='ActModeSanarium' && m.action!='ActModeIR')) &&
              (pin=='' || pin=='HIER_PIN_EINTRAGEN'))) {
      message({message:'confirmAction',action:m.action,errorcode:1,errortext:'Klafs Konfiguration unvollstaendig'});
    } else {
      busy=true;
      // Sofortige Antwort fuer die digitalSTROM-App (Auftrag angenommen).
      message({message:'confirmAction',action:m.action,errorcode:0});
      // passing erzeugt eine Thread-lokale Kopie der Action-ID.
      concurrent passing actionId=m.action {
        try {
          executeAction(actionId);
          refresh();
          log(5,'Klafs Aktion abgeschlossen: %s',actionId);
        } catch as e {
          log(3,'Klafs Aktion nach Annahme fehlgeschlagen (%s): %s',actionId,e);
          message({message:'opstate',level:0,text:'Klafs Aktion fehlgeschlagen'});
        }
        busy=false;
      }
    }
  }
}

return true;
